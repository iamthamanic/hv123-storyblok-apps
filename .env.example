# mock | pat | oauth. Ohne Angabe: pat wenn STORYBLOK_PAT gesetzt ist, sonst mock.
APP_MODE=mock

# Öffentliche https-Adresse der App. Für OAuth Pflicht (Storyblok und die Auth-Bibliothek verlangen https).
APP_URL=https://tools.example.com

STORYBLOK_SPACE_ID=289379092634862
STORYBLOK_REGION=eu

# Persönlicher Zugang für die lokale Entwicklung. Nicht committen.
STORYBLOK_PAT=

# Je Space App eine OAuth-App. Fehlen die Paare, gilt das gemeinsame Paar darunter.
SEITENCHECK_CLIENT_ID=
SEITENCHECK_CLIENT_SECRET=
SCRIPTVERWALTUNG_CLIENT_ID=
SCRIPTVERWALTUNG_CLIENT_SECRET=
STORYBLOK_CLIENT_ID=
STORYBLOK_CLIENT_SECRET=

# true schreibt Stories beim Speichern direkt veröffentlicht.
STORYBLOK_AUTO_PUBLISH=false
